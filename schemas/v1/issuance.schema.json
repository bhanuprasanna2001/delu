{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DE-LU forecast issuance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "content_sha256",
    "contract_version",
    "issuance_id",
    "product",
    "issuance_slot",
    "status",
    "supersedes_issuance_id",
    "information_cutoff",
    "forecast_origin",
    "generated_at",
    "issued_at",
    "published_at",
    "bidding_zone",
    "market_regime",
    "covered_market_delivery_days",
    "currency",
    "unit",
    "resolution",
    "input_profile",
    "degraded",
    "fallback_reason",
    "exaa_sequence_2_admitted",
    "champion_model_versions",
    "code_version",
    "feature_definition_version",
    "data_snapshot",
    "canonical_day_ahead_issuance_id",
    "source_attributions",
    "intervals"
  ],
  "properties": {
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "contract_version": { "const": "v1" },
    "issuance_id": { "type": "string", "minLength": 1 },
    "product": { "const": "day_ahead" },
    "issuance_slot": { "const": "early" },
    "status": { "const": "normal" },
    "supersedes_issuance_id": { "type": "null" },
    "information_cutoff": { "$ref": "#/$defs/instant" },
    "forecast_origin": { "$ref": "#/$defs/instant" },
    "generated_at": { "$ref": "#/$defs/instant" },
    "issued_at": { "$ref": "#/$defs/instant" },
    "published_at": { "$ref": "#/$defs/instant" },
    "bidding_zone": { "const": "DE-LU" },
    "market_regime": { "const": "DE-LU_NATIVE_QUARTER_HOUR" },
    "covered_market_delivery_days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "type": "string", "format": "date" }
    },
    "currency": { "const": "EUR" },
    "unit": { "const": "EUR/MWh" },
    "resolution": { "const": "PT15M" },
    "input_profile": { "type": "string", "minLength": 1 },
    "degraded": { "const": false },
    "fallback_reason": { "type": "null" },
    "exaa_sequence_2_admitted": { "const": false },
    "champion_model_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product",
          "issuance_slot",
          "input_profile",
          "horizon_responsibility",
          "output",
          "model_name",
          "registered_model_version"
        ],
        "properties": {
          "product": { "const": "day_ahead" },
          "issuance_slot": { "const": "early" },
          "input_profile": { "const": "early_core" },
          "horizon_responsibility": { "const": "D+1" },
          "output": { "enum": ["point", "probabilistic"] },
          "model_name": { "type": "string", "minLength": 1 },
          "registered_model_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "code_version": { "type": "string", "minLength": 1 },
    "feature_definition_version": { "type": "string", "minLength": 1 },
    "data_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_snapshot_id", "manifest_sha256"],
      "properties": {
        "data_snapshot_id": { "type": "string", "minLength": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "canonical_day_ahead_issuance_id": { "type": "null" },
    "source_attributions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "name", "url", "licence", "licence_url"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "licence": { "type": "string", "minLength": 1 },
          "licence_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "intervals": {
      "type": "array",
      "minItems": 92,
      "maxItems": 100,
      "oneOf": [
        { "minItems": 92, "maxItems": 92 },
        { "minItems": 96, "maxItems": 96 },
        { "minItems": 100, "maxItems": 100 }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "delivery_start_utc",
          "delivery_end_utc",
          "delivery_start_local",
          "utc_offset",
          "market_delivery_day",
          "interval_position",
          "point",
          "q10",
          "q25",
          "q50",
          "q75",
          "q90"
        ],
        "properties": {
          "delivery_start_utc": { "$ref": "#/$defs/instant" },
          "delivery_end_utc": { "$ref": "#/$defs/instant" },
          "delivery_start_local": { "type": "string", "format": "date-time" },
          "utc_offset": { "type": "string", "pattern": "^[+-][0-9]{2}:[0-9]{2}$" },
          "market_delivery_day": { "type": "string", "format": "date" },
          "interval_position": { "type": "integer", "minimum": 1, "maximum": 100 },
          "point": { "type": "number" },
          "q10": { "type": "number" },
          "q25": { "type": "number" },
          "q50": { "type": "number" },
          "q75": { "type": "number" },
          "q90": { "type": "number" }
        }
      }
    }
  },
  "$defs": {
    "instant": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
